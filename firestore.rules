rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function bounded(data) { return data is map && data.size() <= 24 && data.keys().hasOnly(['month','type','id','record','deleted','revision','updatedAt','operationId','entityKey','baseRevision','status','createdAt','local','remote','theme','categories','budgets','version']); }
    function validStamp(value) { return value is timestamp; }
    function validRevision(data) {
      return data.get('revision', null) is string
        ? (data.get('revision', null).size() > 0 && data.get('revision', null).size() <= 128 && validStamp(data.get('updatedAt', null)))
        : false;
    }
    function validSettingsRevision(data) {
      return data.get('revision', null) is string
        ? (data.get('revision', null).size() > 0 && data.get('revision', null).size() <= 128)
        : false;
    }
    function validSettingsManifest(data) {
      return data is map ? (data.keys().hasOnly(['version','theme','categoryCount','budgetCount','generation','revision'])
        && data.keys().hasAll(['version','theme','categoryCount','budgetCount','generation','revision'])
        ? (data.get('theme', null) is string ? (data.theme in ['claro','escuro','rosa','floresta','pangolim']
          ? (data.get('version', null) is int ? (data.version == 4
            ? (data.get('categoryCount', null) is int ? (data.categoryCount >= 0 && data.categoryCount <= 1000
              ? (data.get('budgetCount', null) is int ? (data.budgetCount >= 0 && data.budgetCount <= 1000
                ? (data.get('generation', null) is string ? (data.generation.size() > 0 && data.generation.size() <= 128 && validSettingsRevision(data)) : false)
                : false) : false)
              : false) : false)
            : false) : false)
          : false) : false)
        : false) : false;
    }
    function validRecord(data, topId, type) {
      return data is map ? (data.keys().hasOnly(['id','nome','valor','serie','categoria','pago','fixa','parcela','recebido'])
        && data.keys().hasAll(['id','nome','valor'])
        && (data.get('id', null) is string ? data.get('id', null) == topId : false)
        && (data.get('nome', null) is string ? (data.get('nome', null).matches('.*[^\\s\\x{00A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}].*') && data.get('nome', null).size() <= 80) : false)
        && (data.get('valor', null) is number ? (data.get('valor', null) >= 0 && data.get('valor', null) <= 17592186044416
          && (((data.get('valor', null) * 100) % 1) < 0.000001 || ((data.get('valor', null) * 100) % 1) > 0.999999)) : false)
        && (data.get('serie', null) == null ? true : (data.get('serie', null) is string ? data.get('serie', null).size() <= 128 : false))
        && (!data.keys().hasAny(['categoria']) || (data.get('categoria', null) is string ? data.get('categoria', null).size() <= 40 : false))
        && (!data.keys().hasAny(['pago']) || data.get('pago', null) is bool)
        && (data.keys().hasAny(['recebido']) ? (data.get('recebido', null) is bool ? type == 'receitas' : false) : true)
        && (!data.keys().hasAny(['fixa']) || data.get('fixa', null) is bool)
        && (data.get('parcela', null) == null ? true : (data.get('parcela', null) is map
          ? (data.get('parcela', null).keys().hasOnly(['atual','total']) && data.get('parcela', null).keys().hasAll(['atual','total'])
            && (data.get('parcela', null).get('atual', null) is int && data.get('parcela', null).get('atual', null) >= 1)
            && (data.get('parcela', null).get('total', null) is int && data.get('parcela', null).get('total', null) >= 2)
            && data.get('parcela', null).get('atual', 0) <= data.get('parcela', null).get('total', 0))
          : false))) : false;
    }
    function validRecordShape(data) {
      return data is map ? (data.keys().hasOnly(['month','type','id','record','deleted','revision','updatedAt'])
        ? (data.get('deleted', null) is bool ? (data.deleted
          ? (data.keys().hasOnly(['month','type','id','deleted','revision','updatedAt'])
            ? (data.keys().hasAll(['month','type','id','deleted','revision','updatedAt'])
              ? (data.get('month', null) is string ? (data.month.matches('^(20[0-9]{2}|2100)-(0[1-9]|1[0-2])$')
                ? (data.get('type', null) is string ? (data.type in ['receitas','despesas']
                  ? (data.get('id', null) is string ? (data.id.size() > 0 && data.id.size() <= 128) : false) : false) : false) : false) : false)
              : false) : false)
          : (data.keys().hasOnly(['month','type','id','record','deleted','revision','updatedAt'])
            ? (data.keys().hasAll(['month','type','id','record','deleted','revision','updatedAt'])
              ? (data.get('month', null) is string ? (data.month.matches('^(20[0-9]{2}|2100)-(0[1-9]|1[0-2])$')
                ? (data.get('type', null) is string ? (data.type in ['receitas','despesas']
                  ? (data.get('id', null) is string ? (data.id.size() > 0 && data.id.size() <= 128 ? validRecord(data.get('record', null), data.id, data.type) : false) : false) : false) : false) : false) : false)
              : false) : false)) : false)
        : false) : false;
    }
    function validCategorySetting(data) {
      return data is map && data.keys().hasOnly(['name','budget']) && data.keys().hasAll(['name'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && (data.keys().hasAny(['budget']) ? (data.budget is number ? (data.budget >= 0 && data.budget <= 17592186044416) : false) : true);
    }
    // One atomic pointer publishes a completely sealed financial generation.
    function legacyActive(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)/control/restore);
    }
    function currentGeneration(uid) {
      return legacyActive(uid) ? 'legacy' : get(/databases/$(database)/documents/users/$(uid)/control/restore).data.activeGeneration;
    }
    function generationActive(uid, generation) { return owner(uid) && currentGeneration(uid) == generation; }
    function generationPath(uid, generation) { return /databases/$(database)/documents/users/$(uid)/financeGenerations/$(generation); }
    function generationWritable(uid, generation) {
      let root = get(generationPath(uid, generation)).data;
      return owner(uid) && (currentGeneration(uid) == generation
        || (root.status == 'staging' && currentGeneration(uid) == root.baseGeneration));
    }
    function snapshotPath(uid, generation, id) {
      return /databases/$(database)/documents/users/$(uid)/financeGenerations/$(generation)/settingsSnapshots/$(id);
    }
    function validGenerationId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$') && id != 'legacy'; }
    function validGeneration(data) {
      return data.keys().hasOnly(['baseGeneration','recordCount','written','lastKey','settingsId','status','createdAt'])
        && data.keys().hasAll(['baseGeneration','recordCount','written','lastKey','settingsId','status','createdAt'])
        && data.baseGeneration is string && data.recordCount is int && data.recordCount >= 0
        && data.written is int && data.written >= 0 && data.written <= data.recordCount
        && data.lastKey is string && data.lastKey.size() <= 1500 && validGenerationId(data.settingsId)
        && data.status in ['staging','ready'] && data.createdAt is timestamp;
    }
    function advanceGeneration(uid, generation, old, next) {
      let recordPath = /databases/$(database)/documents/users/$(uid)/financeGenerations/$(generation)/records/$(next.lastKey);
      return next.diff(old).affectedKeys().hasOnly(['written','lastKey']) && next.written == old.written + 1
        && !exists(recordPath) && existsAfter(recordPath) && getAfter(recordPath).data.index == old.written;
    }
    function sealGeneration(uid, generation, old, next) {
      let settings = /databases/$(database)/documents/users/$(uid)/financeGenerations/$(generation)/settings/finance;
      return next.diff(old).affectedKeys().hasOnly(['status']) && next.status == 'ready' && next.written == next.recordCount
        && existsAfter(settings) && getAfter(settings).data.snapshot == next.settingsId
        && get(snapshotPath(uid, generation, next.settingsId)).data.status == 'ready';
    }
    match /users/{uid}/control/restore {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['protocol','activeGeneration','previousGeneration','activatedAt'])
        && request.resource.data.keys().hasAll(['protocol','activeGeneration','previousGeneration','activatedAt'])
        && request.resource.data.protocol == 2 && validGenerationId(request.resource.data.activeGeneration)
        && request.resource.data.previousGeneration == currentGeneration(uid) && request.resource.data.activatedAt == request.time
        && get(generationPath(uid, request.resource.data.activeGeneration)).data.status == 'ready'
        && get(generationPath(uid, request.resource.data.activeGeneration)).data.baseGeneration == currentGeneration(uid);
      allow delete: if false;
    }
    match /users/{uid}/financeGenerations/{generation} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validGenerationId(generation) && validGeneration(request.resource.data)
        && request.resource.data.baseGeneration == currentGeneration(uid) && request.resource.data.written == 0
        && request.resource.data.lastKey == '' && request.resource.data.status == 'staging' && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validGeneration(request.resource.data) && resource.data.status == 'staging'
        && currentGeneration(uid) == resource.data.baseGeneration
        && (request.resource.data.status == 'ready' ? sealGeneration(uid, generation, resource.data, request.resource.data)
          : advanceGeneration(uid, generation, resource.data, request.resource.data));
      allow delete: if false;
      match /records/{id} {
        allow get: if owner(uid);
        allow list: if owner(uid) && get(generationPath(uid, generation)).data.status == 'ready';
        allow create, update: if owner(uid) && (validRecordShape(request.resource.data.get('value', null))
          ? (validRevision(request.resource.data.value) && (generationActive(uid, generation)
            ? request.resource.data.keys().hasOnly(['value'])
            : (request.resource.data.keys().hasOnly(['index','value']) && !exists(/databases/$(database)/documents/users/$(uid)/financeGenerations/$(generation)/records/$(id))
              && generationWritable(uid, generation) && get(generationPath(uid, generation)).data.status == 'staging'
              && request.resource.data.index == get(generationPath(uid, generation)).data.written
              && getAfter(generationPath(uid, generation)).data.written == request.resource.data.index + 1
              && getAfter(generationPath(uid, generation)).data.lastKey == id))) : false);
        allow delete: if false;
      }
      match /settingsSnapshots/{snapshot} {
        allow read: if owner(uid);
        allow create: if generationWritable(uid, generation) && validGenerationId(snapshot)
          && request.resource.data.keys().hasOnly(['count','written','hash','status'])
          && request.resource.data.keys().hasAll(['count','written','hash','status'])
          && request.resource.data.count is int && request.resource.data.count > 0 && request.resource.data.written == 0
          && request.resource.data.status == 'staging' && request.resource.data.hash is string && request.resource.data.hash.size() <= 128;
        allow update: if generationWritable(uid, generation) && resource.data.status == 'staging'
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['written'])
              && request.resource.data.written == resource.data.written + 1 && request.resource.data.written <= resource.data.count
              && existsAfter(/databases/$(database)/documents/users/$(uid)/financeGenerations/$(generation)/settingsSnapshots/$(snapshot)/chunks/$(string(resource.data.written))))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status == 'ready' && resource.data.written == resource.data.count));
        allow delete: if false;
        match /chunks/{chunk} {
          allow read: if owner(uid);
          allow create: if generationWritable(uid, generation)
            && request.resource.data.keys().hasOnly(['index','text']) && request.resource.data.keys().hasAll(['index','text'])
            && request.resource.data.index is int && request.resource.data.index >= 0 && chunk == string(request.resource.data.index)
            && request.resource.data.text is string && request.resource.data.text.size() <= 128000
            && get(snapshotPath(uid, generation, snapshot)).data.status == 'staging'
            && get(snapshotPath(uid, generation, snapshot)).data.written == request.resource.data.index
            && getAfter(snapshotPath(uid, generation, snapshot)).data.written == request.resource.data.index + 1;
          allow update, delete: if false;
        }
      }
      match /settings/finance {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['snapshot','updatedAt'])
          && request.resource.data.keys().hasAll(['snapshot','updatedAt']) && validGenerationId(request.resource.data.snapshot)
          && request.resource.data.updatedAt == request.time
          && get(snapshotPath(uid, generation, request.resource.data.snapshot)).data.status == 'ready'
          && (generationActive(uid, generation) || (generationWritable(uid, generation)
            && getAfter(generationPath(uid, generation)).data.status == 'ready'
            && request.resource.data.snapshot == getAfter(generationPath(uid, generation)).data.settingsId));
        allow delete: if false;
      }
      match /operations/{id} {
        allow read: if owner(uid);
        allow create: if generationActive(uid, generation) && request.resource.data.keys().hasOnly(['status','createdAt','local'])
          && request.resource.data.status in ['applied','conflict'] && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /conflicts/{id} {
        allow read: if owner(uid);
        allow create: if generationActive(uid, generation) && request.resource.data.keys().hasOnly(['operationId','entityKey','local','remote','createdAt'])
          && request.resource.data.operationId == id && request.resource.data.local is map && request.resource.data.createdAt == request.time;
        allow update: if generationActive(uid, generation) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved','resolution','resolvedAt'])
          && request.resource.data.resolved == true && request.resource.data.resolution in ['local','remote','both'] && request.resource.data.resolvedAt == request.time;
        allow delete: if false;
      }
    }
    match /users/{uid}/records/{recordId} {
      allow read: if owner(uid);
      // Active record includes `record`; tombstone is the same envelope without `record`.
      allow create, update: if owner(uid) && (validRecordShape(request.resource.data)
        ? (validRevision(request.resource.data) && legacyActive(uid)) : false);
      allow delete: if false;
    }
    match /users/{uid}/settings/{settingsId} {
      allow read: if owner(uid);
      allow create, update: if false;
      allow delete: if false;
    }
    // V2 settings are additive: the old finance document remains readable as a fallback.
    match /users/{uid}/settingsV2/{settingsId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && legacyActive(uid) && settingsId == 'finance' && validSettingsManifest(request.resource.data);
      allow delete: if false;
      match /generations/{generation}/categories/{categoryId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && legacyActive(uid) && generation.size() > 0 && generation.size() <= 128
          && categoryId.matches('^c_[A-Za-z0-9%_.-]{1,500}$')
          && validCategorySetting(request.resource.data);
        allow update: if false;
        allow delete: if false;
      }
    }
    match /users/{uid}/operations/{operationId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && legacyActive(uid) && bounded(request.resource.data) && request.resource.data.status in ['applied','conflict'];
      allow update, delete: if false;
    }
    match /users/{uid}/conflicts/{conflictId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && legacyActive(uid) && request.resource.data is map
        && request.resource.data.keys().hasOnly(['operationId','entityKey','local','remote','createdAt'])
        && request.resource.data.keys().hasAll(['operationId','entityKey','local','remote','createdAt'])
        && request.resource.data.operationId == conflictId && conflictId.size() <= 128
        && request.resource.data.entityKey is string && request.resource.data.entityKey.size() <= 512
        && request.resource.data.local is map
        && (request.resource.data.remote == null || request.resource.data.remote is map)
        && validStamp(request.resource.data.get('createdAt', null));
      allow update: if owner(uid) && legacyActive(uid) && resource.data.keys().hasOnly(['operationId','entityKey','local','remote','createdAt'])
        && request.resource.data.keys().hasOnly(['operationId','entityKey','local','remote','createdAt','resolved','resolution','resolvedAt'])
        && request.resource.data.keys().hasAll(['operationId','entityKey','local','remote','createdAt','resolved','resolution','resolvedAt'])
        && request.resource.data.operationId == resource.data.operationId
        && request.resource.data.entityKey == resource.data.entityKey
        && request.resource.data.local == resource.data.local
        && request.resource.data.remote == resource.data.remote
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.resolved == true && request.resource.data.resolution in ['local','remote','both']
        && validStamp(request.resource.data.get('resolvedAt', null));
      allow delete: if false;
    }
    match /users/{uid}/meta/{metaId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && legacyActive(uid) && metaId == 'sync' && bounded(request.resource.data);
      allow delete: if false;
    }
    match /users/{uid}/{document=**} { allow read, write: if false; }
  }
}

